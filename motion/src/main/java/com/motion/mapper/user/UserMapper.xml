<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.motion.mapper.user.UserMapper">

    <insert id="insertUser" parameterType="com.motion.user.model.UserDTO">
        INSERT INTO m_user (email, name, profile)
        VALUES (#{email}, #{name}, #{profile})
    </insert>
    <select id="selectUser" parameterType="String" resultType="com.motion.user.model.UserDTO">
        SELECT *
        FROM m_user
        WHERE email = #{email}
    </select>
</mapper>